#!/usr/bin/python3 -I
"""Report disk, storage and host health to Home Assistant (Proxmox Host Monitor).

Runs from proxmox-host-monitor-disks.timer and immediately when smartd raises
a warning. The evaluation is deliberately strict: every pending or
uncorrectable sector and every Btrfs device error counts as critical.
"""

from datetime import datetime, timezone
import glob
import json
import re
import socket
import time
import subprocess
import sys
import urllib.request

WEBHOOK_URL_FILE = "/etc/proxmox-host-monitor/webhook-url"

TEMP_WARNING = 50
TEMP_CRITICAL = 55

# The last self-test may be at most this many power-on hours old (smartd
# runs a short test every day when scheduled with -s).
SELF_TEST_MAX_AGE_HOURS = 8 * 24

# ATA attribute id: (key, severity when the raw value is above zero)
ATA_CHECKS = {
    5: ("reallocated_sectors", "warning"),
    187: ("reported_uncorrectable", "critical"),
    188: ("command_timeouts", "warning"),
    197: ("pending_sectors", "critical"),
    198: ("offline_uncorrectable", "critical"),
    199: ("crc_errors", "warning"),
}

RANK = {"ok": 0, "warning": 1, "critical": 2}

DAY = 24 * 3600
SCRUB_MAX_AGE = 35 * DAY
BACKUP_MAX_AGE = 8 * DAY
CERT_WARNING = 30 * DAY
THIN_WARNING = 80
THIN_CRITICAL = 90
# Host temperature limits when the sensor does not provide its own.
HOST_TEMP_WARNING = 85
HOST_TEMP_CRITICAL = 95


def smartctl(*args):
    result = subprocess.run(
        ["smartctl", "-j", *args], capture_output=True, text=True, check=False
    )
    try:
        return json.loads(result.stdout), result.returncode
    except json.JSONDecodeError:
        return {}, result.returncode


def disk_info(data):
    """Return general, mostly static information about a disk."""
    attrs = {
        attr["id"]: attr["raw"]["value"] & 0xFFFFFFFF
        for attr in data.get("ata_smart_attributes", {}).get("table", [])
    }
    nvme = data.get("nvme_smart_health_information_log", {})
    rotation = data.get("rotation_rate")
    info = {
        "model_family": data.get("model_family"),
        "firmware": data.get("firmware_version"),
        "capacity": data.get("user_capacity", {}).get("bytes") or data.get("nvme_total_capacity"),
        "protocol": data.get("device", {}).get("protocol"),
        "interface": data.get("sata_version", {}).get("string")
        or data.get("interface_speed", {}).get("current", {}).get("string"),
        # 0 means a solid state disk; None means the disk does not say.
        "rotation_rate": 0 if nvme else rotation,
        "form_factor": data.get("form_factor", {}).get("name"),
        "smart_passed": data.get("smart_status", {}).get("passed"),
        "self_test_supported": bool(
            data.get("ata_smart_data", {}).get("capabilities", {}).get("self_tests_supported")
            or data.get("nvme_optional_admin_commands", {}).get("self_test")
        ),
        "power_cycles": data.get("power_cycle_count", nvme.get("power_cycles")),
        "start_stop_count": attrs.get(4),
        "load_cycles": attrs.get(193),
    }

    tests = (
        data.get("ata_smart_self_test_log", {}).get("standard", {}).get("table")
        or data.get("nvme_self_test_log", {}).get("table")
        or []
    )
    if tests:
        last = tests[0]
        hours = data.get("power_on_time", {}).get("hours")
        info["self_test"] = {
            "type": last.get("type", {}).get("string"),
            "result": last.get("status", {}).get("string"),
            "passed": last.get("status", {}).get("passed"),
            "hours_ago": hours - last["lifetime_hours"]
            if hours is not None and "lifetime_hours" in last else None,
        }
    return {key: value for key, value in info.items() if value is not None}


def self_test_completions():
    """Return when smartd last saw a self-test complete, per disk name.

    Some old disks count the hours in their self-test log differently from
    their power-on hours, so the wall clock of smartd's log is more reliable.
    """
    log = run("journalctl", "-u", "smartmontools", "-u", "smartd", "--since", "-60d",
              "-o", "short-unix", "--no-pager", "--grep", "self-test completed").stdout
    completions = {}
    for stamp, name in re.findall(
        r"^(\d+)(?:\.\d+)? .*Device:? /dev/(\w+).*self-test completed", log, re.M
    ):
        completions[name] = int(stamp)
    return completions


def check_disk(dev, completions=None):
    data, rc = smartctl("-a", "-n", "standby", "-d", dev["type"], dev["name"])
    # A disk in standby is skipped instead of being woken up.
    if rc & 2 and not data.get("smart_status"):
        return None

    disk = {
        "name": dev["name"].removeprefix("/dev/"),
        "model": data.get("model_name", ""),
        "serial": data.get("serial_number", ""),
        "status": "ok",
        "temperature": data.get("temperature", {}).get("current"),
        "power_on_hours": data.get("power_on_time", {}).get("hours"),
        "problems": [],
    }
    if not disk["serial"]:
        return None
    disk.update(disk_info(data))

    def problem(code, severity, value=None):
        disk["problems"].append({"code": code, "severity": severity, "value": value})
        if RANK[severity] > RANK[disk["status"]]:
            disk["status"] = severity

    if data.get("smart_status", {}).get("passed") is False:
        problem("smart_failed", "critical")
    if rc & 8:
        problem("failure_predicted", "critical")
    if rc & 16:
        problem("prefail_in_past", "warning")
    if rc & 64:
        problem("error_log", "warning")
    if rc & 128:
        problem("self_test_failed", "warning")

    for attr in data.get("ata_smart_attributes", {}).get("table", []):
        if attr["id"] in ATA_CHECKS:
            key, severity = ATA_CHECKS[attr["id"]]
            # Some vendors pack extra data into the upper bytes.
            value = attr["raw"]["value"] & 0xFFFFFFFF
            disk[key] = value
            if value > 0:
                problem(key, severity, value)

    nvme = data.get("nvme_smart_health_information_log")
    if nvme:
        disk["percentage_used"] = nvme["percentage_used"]
        disk["media_errors"] = nvme["media_errors"]
        if nvme["critical_warning"]:
            problem("nvme_critical_warning", "critical", nvme["critical_warning"])
        if nvme["media_errors"]:
            problem("media_errors", "critical", nvme["media_errors"])
        if nvme["available_spare"] < nvme["available_spare_threshold"]:
            problem("available_spare", "critical", nvme["available_spare"])
        if nvme["percentage_used"] >= 80:
            problem("percentage_used", "warning", nvme["percentage_used"])

    completed = (completions or {}).get(disk["name"])
    if completed is not None and "self_test" in disk:
        hours = int((time.time() - completed) / 3600)
        current = disk["self_test"].get("hours_ago")
        if current is None or current < 0 or hours < current:
            disk["self_test"]["hours_ago"] = hours

    if disk.get("self_test_supported"):
        hours_ago = disk.get("self_test", {}).get("hours_ago")
        if "self_test" not in disk:
            problem("self_test_overdue", "warning")
        elif hours_ago is not None and hours_ago > SELF_TEST_MAX_AGE_HOURS:
            problem("self_test_overdue", "warning", hours_ago)

    temp = disk["temperature"]
    if temp is not None and temp >= TEMP_CRITICAL:
        problem("temperature", "critical", temp)
    elif temp is not None and temp >= TEMP_WARNING:
        problem("temperature", "warning", temp)

    return disk


def run(*args):
    return subprocess.run(args, capture_output=True, text=True, check=False)


def btrfs_mounts():
    """Return one mount point per Btrfs filesystem, keyed by UUID."""
    # Subvolume mounts of the same filesystem share devices and counters.
    mounts = {}
    for line in run("findmnt", "-rn", "-t", "btrfs", "-o", "UUID,TARGET").stdout.splitlines():
        uuid, _, target = line.partition(" ")
        mounts.setdefault(uuid, target.replace("\\x20", " "))
    return mounts


def btrfs_errors(mounts):
    """Return the summed Btrfs device error counters per disk name."""
    errors = {}
    for mount in mounts.values():
        for line in run("btrfs", "device", "stats", mount).stdout.splitlines():
            match = re.match(r"\[/dev/(sd[a-z]+|nvme\d+)\S*\]\.\w+\s+(\d+)", line)
            if match:
                errors[match.group(1)] = errors.get(match.group(1), 0) + int(match.group(2))
    return errors


def disk_name(path):
    """Return the whole-disk name of a device or partition path."""
    match = re.match(r"/dev/(sd[a-z]+|nvme\d+)", path)
    return match.group(1) if match else path.removeprefix("/dev/")


# Copies per profile and minimum number of devices.
MIRRORS = {"single": (1, 1), "dup": (1, 1), "raid0": (1, 1), "raid1": (2, 2),
           "raid1c3": (3, 3), "raid1c4": (4, 4), "raid10": (2, 2), "raid5": (1, 2), "raid6": (1, 3)}
GIB = 1024**3


def mirror_capacity(sizes, copies):
    """Return how much data with this many copies fits on the devices."""
    sizes = sorted(sizes, reverse=True)
    if len(sizes) < copies:
        return 0
    return min(sum(sizes[j:]) / (copies - j) for j in range(copies))


def raw_ratio(profile, devices):
    """Return raw bytes needed per byte of data in a profile."""
    copies, _ = MIRRORS.get(profile, (1, 1))
    if profile == "dup":
        return 2
    if profile == "raid5":
        return devices / max(devices - 1, 1)
    if profile == "raid6":
        return devices / max(devices - 2, 1)
    return copies


def fits(profiles, sizes):
    """Return the bytes missing to store all profiles on these devices (0 = fits)."""
    total = sum(sizes)
    # Reserve for metadata growth and allocation slack.
    needed = 2 * GIB + 0.05 * total
    missing = 0
    for copies in (2, 3, 4):
        mirrored = sum(used for profile, used in profiles.items()
                       if MIRRORS.get(profile, (1, 1))[0] >= copies)
        if mirrored:
            missing = max(missing, mirrored * copies - mirror_capacity(sizes, copies) * copies)
    for profile, used in profiles.items():
        if len(sizes) < MIRRORS.get(profile, (1, 1))[1]:
            return max(total, 1)
        needed += used * raw_ratio(profile, len(sizes))
    return int(max(missing, needed - total, 0))


def btrfs_pools(mounts, serials):
    """Describe every Btrfs filesystem and whether each disk could be removed."""
    pools = []
    for uuid, mount in mounts.items():
        show = run("btrfs", "filesystem", "show", "--raw", mount).stdout
        label = re.search(r"Label: '([^']*)'", show)
        devices = [
            {"devid": int(devid), "size": int(size), "used": int(used),
             "name": disk_name(path), "serial": serials.get(disk_name(path), "")}
            for devid, size, used, path in re.findall(
                r"devid\s+(\d+)\s+size\s+(\d+)\s+used\s+(\d+)\s+path\s+(\S+)", show)
        ]
        profiles = {}
        kinds = {}
        for kind, profile, used in re.findall(
            r"^(Data|Metadata|System), ([\w]+): total=\d+, used=(\d+)",
            run("btrfs", "filesystem", "df", "--raw", mount).stdout, re.M,
        ):
            profile = profile.lower()
            profiles[profile] = profiles.get(profile, 0) + int(used)
            kinds.setdefault(kind.lower(), []).append(profile)

        usage = run("btrfs", "filesystem", "usage", "--raw", mount).stdout
        # Btrfs' estimate ignores that a mirror is limited by its smaller disk;
        # the statfs value respects it, so the smaller of both is reported.
        free_values = [
            int(value) for value in re.findall(
                r"Free \((?:estimated|statfs, df)\):\s+(\d+)", usage)
        ]
        size = sum(device["size"] for device in devices)
        balance = run("btrfs", "balance", "status", mount).stdout

        for device in devices:
            others = [d["size"] for d in devices if d is not device]
            device["missing_after_removal"] = fits(profiles, others)

        pools.append({
            "uuid": uuid,
            "mount": mount,
            "label": label.group(1) if label and label.group(1) != "none" else "",
            "size": size,
            "used": sum(profiles.values()),
            "free": min(free_values) if free_values else None,
            "profiles": kinds,
            "balance_running": "is running" in balance or "is paused" in balance,
            "balance_progress": balance_progress(balance),
            "devices": devices,
            "operations": removal_operations(),
            "scrub": scrub_status(mount),
        })
    return pools


def balance_progress(status):
    """Return the share of a running balance that is done, in percent."""
    match = re.search(r"(\d+)% left", status)
    return 100 - int(match.group(1)) if match else None


def scrub_status(mount):
    """Return the result of the last scrub, or None if there never was one."""
    status = run("btrfs", "scrub", "status", "-R", mount).stdout
    progress = re.search(
        r"Bytes scrubbed:.*\(([\d.]+)%\)", run("btrfs", "scrub", "status", mount).stdout
    )
    started = re.search(r"Scrub started:\s+(.+)", status)
    if not started:
        return None
    try:
        last = datetime.strptime(started.group(1).strip(), "%a %b %d %H:%M:%S %Y").timestamp()
    except ValueError:
        last = None
    duration = re.search(r"Duration:\s+(\d+):(\d+):(\d+)", status)
    state = re.search(r"Status:\s+(\w+)", status)

    def count(name):
        match = re.search(rf"{name}:\s+(\d+)", status)
        return int(match.group(1)) if match else 0

    return {
        "last": last,
        "status": state.group(1) if state else None,
        "duration": int(duration.group(1)) * 3600 + int(duration.group(2)) * 60
        + int(duration.group(3)) if duration else None,
        "errors": sum(count(n) for n in ("read_errors", "csum_errors", "verify_errors", "super_errors")),
        "corrected": count("corrected_errors"),
        "uncorrectable": count("uncorrectable_errors"),
        "progress": float(progress.group(1)) if progress else None,
    }


def kernel_io_errors():
    """Return the failed I/O requests per disk in the kernel log of the last day."""
    log = run("journalctl", "-k", "--since", "-24h", "-o", "cat", "--no-pager").stdout
    errors = {}
    for name in re.findall(r"I/O error, dev (nvme\d+|[a-z]+)", log):
        errors[name] = errors.get(name, 0) + 1
    return errors


REMOVE_UNIT = "proxmox-host-monitor-remove-"


def removal_operations():
    """Return the state of disk removals started from Home Assistant."""
    listing = run("systemctl", "list-units", "--all", "--plain", "--no-legend",
                  f"{REMOVE_UNIT}*.service").stdout
    operations = []
    for unit in re.findall(rf"({REMOVE_UNIT}\S+)\.service", listing):
        props = dict(
            line.split("=", 1)
            for line in run("systemctl", "show", "-p", "ActiveState,SubState,Result",
                            f"{unit}.service").stdout.splitlines() if "=" in line
        )
        active, sub, result = props.get("ActiveState"), props.get("SubState"), props.get("Result")
        if result not in ("success", None, ""):
            state = "failed"
        elif active == "active" and sub == "exited":
            state = "done"
        elif active in ("active", "activating", "deactivating"):
            state = "running"
        else:
            state = "done"
        operations.append({
            "action": "btrfs_remove",
            "serial": unit.removeprefix(REMOVE_UNIT),
            "state": state,
        })
    return operations


def execute(command, pools):
    """Start a disk removal requested from Home Assistant after checking it again."""
    if command.get("action") != "btrfs_remove":
        return f"unknown action {command.get('action')}"
    serial = str(command.get("serial", ""))
    if not re.fullmatch(r"[\w.-]+", serial):
        return "invalid serial"
    pool = next((p for p in pools if p["uuid"] == command.get("pool")), None)
    if pool is None:
        return "pool not found"
    device = next((d for d in pool["devices"] if d["serial"] == serial), None)
    if device is None:
        return f"disk {serial} is not part of the pool"
    if pool["balance_running"]:
        return "a balance is running, try again later"
    if any(op["state"] == "running" for op in pool["operations"]):
        return "another removal is running"
    if device["missing_after_removal"]:
        return f"not enough space, {device['missing_after_removal']} bytes missing"

    unit = f"{REMOVE_UNIT}{serial}"
    run("systemctl", "reset-failed", f"{unit}.service")
    result = run(
        "systemd-run", f"--unit={unit}", "--property=RemainAfterExit=yes",
        f"--description=Proxmox Host Monitor: remove {device['name']} ({serial}) from {pool['mount']}",
        "btrfs", "device", "remove", str(device["devid"]), pool["mount"],
    )
    return "started" if result.returncode == 0 else result.stderr.strip()


def read(path, default=None):
    try:
        with open(path, encoding="utf-8") as file:
            return file.read().strip()
    except OSError:
        return default


def hwmon():
    """Return host temperatures and fans; disks are covered by SMART."""
    temperatures, fans = [], []
    for chip in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        name = read(f"{chip}/name", "")
        if name in ("nvme", "drivetemp"):
            continue
        for path in sorted(glob.glob(f"{chip}/temp*_input")):
            base = path.removesuffix("_input")
            value = read(path)
            if value is None or not value.lstrip("-").isdigit():
                continue
            limits = {}
            for limit in ("max", "crit"):
                raw = read(f"{base}_{limit}")
                # Some drivers and BIOSes report nonsense like 65261 °C or 26 °C;
                # no real component has a limit below 40 °C.
                if raw and raw.lstrip("-").isdigit() and 40 <= int(raw) / 1000 < 150:
                    limits[limit] = int(raw) / 1000
            temperatures.append({
                "chip": name,
                "label": read(f"{base}_label") or base.rsplit("/", 1)[1],
                "value": int(value) / 1000,
                **limits,
            })
        for path in sorted(glob.glob(f"{chip}/fan*_input")):
            base = path.removesuffix("_input")
            value = read(path)
            if value is not None and value.isdigit():
                fans.append({
                    "chip": name,
                    "label": read(f"{base}_label") or base.rsplit("/", 1)[1],
                    "rpm": int(value),
                })
    return temperatures, fans


def thin_pools():
    data = run("lvs", "--reportformat", "json", "-o",
               "vg_name,lv_name,lv_attr,data_percent,metadata_percent").stdout
    try:
        lvs = json.loads(data)["report"][0]["lv"]
    except (ValueError, KeyError, IndexError):
        return []
    return [
        {
            "name": f"{lv['vg_name']}/{lv['lv_name']}",
            "data_percent": float(lv["data_percent"] or 0),
            "metadata_percent": float(lv["metadata_percent"] or 0),
        }
        for lv in lvs
        if lv.get("lv_attr", "").startswith("t")
    ]


def nics():
    """Return physical network interfaces."""
    result = []
    for path in sorted(glob.glob("/sys/class/net/*/device")):
        iface = path.split("/")[-2]
        base = f"/sys/class/net/{iface}"
        speed = read(f"{base}/speed")
        result.append({
            "name": iface,
            "state": read(f"{base}/operstate"),
            "speed": int(speed) if speed and speed.isdigit() and int(speed) > 0 else None,
            "rx_errors": int(read(f"{base}/statistics/rx_errors", "0")),
            "tx_errors": int(read(f"{base}/statistics/tx_errors", "0")),
        })
    return result


def backups():
    """Return the number of backup jobs and the last vzdump task of this node."""
    def pvesh(path, *args):
        try:
            return json.loads(run("pvesh", "get", path, *args, "--output-format", "json").stdout)
        except ValueError:
            return None

    jobs = pvesh("/cluster/backup")
    tasks = pvesh(f"/nodes/{socket.gethostname()}/tasks", "--typefilter", "vzdump", "--limit", "1")
    last = tasks[0] if tasks else None
    return {
        "jobs": len(jobs) if isinstance(jobs, list) else None,
        "last": last.get("endtime") or last.get("starttime") if last else None,
        "last_status": last.get("status") if last else None,
    }


def certificate_expires():
    for path in ("/etc/pve/local/pveproxy-ssl.pem", "/etc/pve/local/pve-ssl.pem"):
        out = run("openssl", "x509", "-enddate", "-noout", "-in", path).stdout
        if match := re.search(r"notAfter=(.+)", out):
            try:
                return datetime.strptime(match.group(1).strip(), "%b %d %H:%M:%S %Y %Z").replace(
                    tzinfo=timezone.utc).timestamp()
            except ValueError:
                return None
    return None


def unattended_upgrades():
    log = read("/var/log/unattended-upgrades/unattended-upgrades.log", "")
    results = re.findall(r"^(\S+ \S+),\d+ \w+ upgrade result: (\w+)", log, re.M)
    if not results:
        return None
    when, ok = results[-1]
    return {
        "last": datetime.strptime(when, "%Y-%m-%d %H:%M:%S").timestamp(),
        "success": ok == "True",
    }


def host_report(pools):
    """Return host information and its problems."""
    now = time.time()
    problems = []

    def problem(code, severity, item=None, value=None):
        problems.append({"code": code, "severity": severity, "item": item, "value": value})

    failed = [
        unit for unit in re.findall(
            r"^(\S+\.\w+)\s", run("systemctl", "list-units", "--state=failed",
                                    "--plain", "--no-legend").stdout, re.M)
        # Failed disk removals have their own repair issue.
        if not unit.startswith(REMOVE_UNIT)
    ]
    for unit in failed:
        problem("failed_unit", "warning", unit)

    for pool in pools:
        scrub = pool.get("scrub")
        if scrub is None or scrub.get("last") is None:
            problem("scrub_never", "warning", pool["mount"])
        elif now - scrub["last"] > SCRUB_MAX_AGE:
            problem("scrub_overdue", "warning", pool["mount"], int((now - scrub["last"]) / DAY))
        if scrub and scrub.get("uncorrectable"):
            problem("scrub_uncorrectable", "critical", pool["mount"], scrub["uncorrectable"])
        elif scrub and scrub.get("errors"):
            problem("scrub_errors", "warning", pool["mount"], scrub["errors"])

    backup = backups()
    if backup["jobs"] == 0:
        problem("backup_missing", "warning")
    elif backup["last"] is None:
        problem("backup_never", "warning")
    else:
        if backup["last_status"] not in (None, "OK"):
            problem("backup_failed", "warning", None, backup["last_status"])
        if now - backup["last"] > BACKUP_MAX_AGE:
            problem("backup_overdue", "warning", None, int((now - backup["last"]) / DAY))

    temperatures, fans = hwmon()
    for sensor in temperatures:
        item = f"{sensor['chip']} {sensor['label']}"
        critical = sensor.get("crit", HOST_TEMP_CRITICAL)
        warning = sensor.get("max", HOST_TEMP_WARNING)
        if sensor["value"] >= critical:
            problem("temperature", "critical", item, sensor["value"])
        elif sensor["value"] >= warning:
            problem("temperature", "warning", item, sensor["value"])

    pools_lvm = thin_pools()
    for pool in pools_lvm:
        usage = max(pool["data_percent"], pool["metadata_percent"])
        if usage >= THIN_CRITICAL:
            problem("thin_pool_full", "critical", pool["name"], round(usage, 1))
        elif usage >= THIN_WARNING:
            problem("thin_pool_full", "warning", pool["name"], round(usage, 1))

    interfaces = nics()
    for nic in interfaces:
        if nic["rx_errors"] or nic["tx_errors"]:
            problem("nic_errors", "warning", nic["name"], nic["rx_errors"] + nic["tx_errors"])

    certificate = certificate_expires()
    if certificate is not None and certificate < now:
        problem("certificate_expired", "critical")
    elif certificate is not None and certificate - now < CERT_WARNING:
        problem("certificate_expiring", "warning", None, int((certificate - now) / DAY))

    synced = run("timedatectl", "show", "-p", "NTPSynchronized", "--value").stdout.strip()
    if synced == "no":
        problem("time_not_synchronized", "warning")

    upgrades = unattended_upgrades()
    if upgrades and not upgrades["success"]:
        problem("unattended_upgrades_failed", "warning")

    status = "ok"
    for entry in problems:
        if RANK[entry["severity"]] > RANK[status]:
            status = entry["severity"]

    return {
        "status": status,
        "problems": problems,
        "failed_units": failed,
        "backup": backup,
        "temperatures": temperatures,
        "fans": fans,
        "thin_pools": pools_lvm,
        "nics": interfaces,
        "certificate_expires": certificate,
        "time_synchronized": synced == "yes" if synced else None,
        "unattended_upgrades": upgrades,
    }


def post(payload):
    with open(WEBHOOK_URL_FILE, encoding="utf-8") as file:
        url = file.read().strip()
    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    return json.loads(urllib.request.urlopen(request, timeout=10).read().decode() or "{}")


def main():
    scan, _ = smartctl("--scan-open")
    completions = self_test_completions()
    disks = [
        d for d in (check_disk(dev, completions) for dev in scan.get("devices", [])) if d
    ]

    mounts = btrfs_mounts()
    errors = btrfs_errors(mounts)
    for disk in disks:
        if disk["name"] in errors:
            disk["btrfs_errors"] = errors[disk["name"]]
            if errors[disk["name"]]:
                disk["problems"].append(
                    {"code": "btrfs_errors", "severity": "critical", "value": errors[disk["name"]]}
                )
                disk["status"] = "critical"

    io_errors = kernel_io_errors()
    for disk in disks:
        disk["io_errors_24h"] = io_errors.get(disk["name"], 0)
        if disk["io_errors_24h"]:
            disk["problems"].append(
                {"code": "io_errors", "severity": "warning", "value": disk["io_errors_24h"]}
            )
            if disk["status"] == "ok":
                disk["status"] = "warning"

    pools = btrfs_pools(mounts, {disk["name"]: disk["serial"] for disk in disks})
    payload = {"disks": disks, "pools": pools, "host": host_report(pools)}
    if "--dry-run" in sys.argv:
        print(json.dumps(payload, indent=1))
        return

    response = post(payload)
    print(json.dumps(response))

    results = [
        {**command, "result": execute(command, pools)}
        for command in response.get("commands", [])
    ]
    if results:
        print(json.dumps(results))
        # Report the started removal right away.
        pools = btrfs_pools(mounts, {disk["name"]: disk["serial"] for disk in disks})
        post({"disks": disks, "pools": pools, "command_results": results})


if __name__ == "__main__":
    main()
